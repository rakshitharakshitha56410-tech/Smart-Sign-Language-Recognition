"""
NUMBER COLLECTOR
================
Collects ASL number signs (0–9) using the same pipeline as the letter collector.

Per raw capture saves:
  - 5 JSON landmark files  (landmark augmentation variants)
  - 8 JPG images           (224x224 hand crop, 8 augmentation variants)

Total per raw capture: 13 files.
Default target: 20 raw → ~100 JSON + ~160 images per digit.

Usage:
    python number_collector.py

Dependencies (same as your existing collector):
    pip install mediapipe scipy opencv-python
"""

import cv2
import numpy as np
import json
import os
import time
from datetime import datetime
from collections import deque
from scipy.ndimage import gaussian_filter1d

try:
    import mediapipe as mp
except ImportError:
    print("Install: pip install mediapipe scipy")
    exit()


# ─────────────────────────────────────────────────────────────────────────────
#  COLLECTOR
# ─────────────────────────────────────────────────────────────────────────────

class NumberCollector:
    VALID_DIGITS = set('0123456789')

    def __init__(self):
        print("\n" + "="*80)
        print("ASL NUMBER COLLECTOR")
        print("Digits 0-9  |  JSON (5x aug) + Images (8x aug)  |  224x224 crops")
        print("="*80)

        self._setup_mediapipe()

        self.data_dir = "sign_data"
        os.makedirs(f"{self.data_dir}/numbers", exist_ok=True)

        print("\nCollector ready!\n")

    # ── MediaPipe ────────────────────────────────────────────────────────────

    def _setup_mediapipe(self):
        self.mp_hands = mp.solutions.hands
        self.hands = self.mp_hands.Hands(
            static_image_mode=False,
            max_num_hands=2,
            min_detection_confidence=0.8,
            min_tracking_confidence=0.8,
        )
        self.mp_drawing        = mp.solutions.drawing_utils
        self.mp_drawing_styles = mp.solutions.drawing_styles

    def _draw_hands(self, frame, results):
        if results and results.multi_hand_landmarks:
            for hand in results.multi_hand_landmarks:
                self.mp_drawing.draw_landmarks(
                    frame, hand,
                    self.mp_hands.HAND_CONNECTIONS,
                    self.mp_drawing_styles.get_default_hand_landmarks_style(),
                    self.mp_drawing_styles.get_default_hand_connections_style(),
                )

    # ── Normalisation ─────────────────────────────────────────────────────────

    def _normalize_landmarks(self, landmarks):
        arr = np.array(landmarks, dtype=np.float32).reshape(-1, 3)
        if arr.sum() == 0:
            return arr.flatten().tolist()
        center   = arr.mean(axis=0)
        centered = arr - center
        scale    = np.std(centered)
        if scale > 0:
            centered /= scale
        return centered.flatten().tolist()

    # ── Image augmentation (8 variants) ─────────────────────────────────────

    def _augment_image(self, img):
        variants = [('orig', img.copy())]

        variants.append(('flip', cv2.flip(img, 1)))

        bright = np.clip(img.astype(np.int16) + 40, 0, 255).astype(np.uint8)
        dark   = np.clip(img.astype(np.int16) - 40, 0, 255).astype(np.uint8)
        variants.append(('bright', bright))
        variants.append(('dark',   dark))

        hi_con = np.clip(img.astype(np.float32) * 1.3,  0, 255).astype(np.uint8)
        lo_con = np.clip(img.astype(np.float32) * 0.75, 0, 255).astype(np.uint8)
        variants.append(('con_hi', hi_con))
        variants.append(('con_lo', lo_con))

        h, w = img.shape[:2]
        cx, cy = w // 2, h // 2
        for angle, tag in [(10, 'rot10'), (-10, 'rotm10')]:
            M   = cv2.getRotationMatrix2D((cx, cy), angle, 1.0)
            rot = cv2.warpAffine(img, M, (w, h),
                                 flags=cv2.INTER_LINEAR,
                                 borderMode=cv2.BORDER_REPLICATE)
            variants.append((tag, rot))

        return variants  # 8 total

    def _crop_hand_region(self, frame, results, pad=50):
        h, w = frame.shape[:2]
        all_x, all_y = [], []

        if results and results.multi_hand_landmarks:
            for hand in results.multi_hand_landmarks:
                for lm in hand.landmark:
                    all_x.append(int(lm.x * w))
                    all_y.append(int(lm.y * h))

        if all_x and all_y:
            x1 = max(0,     min(all_x) - pad)
            y1 = max(0,     min(all_y) - pad)
            x2 = min(w - 1, max(all_x) + pad)
            y2 = min(h - 1, max(all_y) + pad)
            crop = frame[y1:y2, x1:x2]
            if crop.size > 0:
                return cv2.resize(crop, (224, 224))

        return cv2.resize(frame, (224, 224))

    # ── Landmark augmentation (5 variants) ───────────────────────────────────

    def _augment_landmarks(self, landmarks):
        arr      = np.array(landmarks, dtype=np.float32).reshape(-1, 3)
        variants = [arr.copy()]

        for angle_deg in [-8, 8]:
            rad   = np.radians(angle_deg)
            cos_a, sin_a = np.cos(rad), np.sin(rad)
            rot = arr.copy()
            x_new = rot[:, 0] * cos_a - rot[:, 1] * sin_a
            y_new = rot[:, 0] * sin_a + rot[:, 1] * cos_a
            rot[:, 0] = x_new
            rot[:, 1] = y_new
            variants.append(rot)

        for scale in [0.92, 1.08]:
            variants.append(arr * scale)

        return [v.flatten().tolist() for v in variants]

    def _check_quality(self, landmarks):
        arr = np.array(landmarks)
        if arr.sum() == 0:
            return False, "No hand detected"
        if np.std(arr) < 0.01:
            return False, "Hand too flat / static"
        return True, "OK"

    # ── Collection loop ───────────────────────────────────────────────────────

    def collect_digit(self, digit: str, target_raw: int = 20):
        """Collect data for a single digit (0-9)."""
        if digit not in self.VALID_DIGITS:
            print(f"Invalid digit: {digit!r}. Must be 0–9.")
            return 0

        save_dir = f"{self.data_dir}/numbers/{digit}"
        img_dir  = f"{save_dir}/images"
        os.makedirs(save_dir, exist_ok=True)
        os.makedirs(img_dir,  exist_ok=True)

        cap = cv2.VideoCapture(0)
        if not cap.isOpened():
            print("Camera error!")
            return 0

        cap.set(cv2.CAP_PROP_FRAME_WIDTH,  1280)
        cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 720)
        cap.set(cv2.CAP_PROP_FPS, 30)

        collected    = 0
        json_saved   = 0
        img_saved    = 0
        last_capture = 0
        INTERVAL     = 1.2   # seconds between auto-captures
        stab_buf     = deque(maxlen=15)

        AUG_LM_TYPES = ['orig', 'rot_-8', 'rot_+8', 'scale_0.92', 'scale_1.08']

        print(f"\n{'='*80}")
        print(f"COLLECTING DIGIT: {digit}")
        print(f"{'='*80}")
        print(f"Each capture saves:  5 JSON files  +  8 cropped hand images")
        print(f"Target: {target_raw} raw → ~{target_raw*5} JSON + ~{target_raw*8} images")
        print("Show the ASL sign for this digit and hold it steady.")
        print("Auto-captures when stable.   Q = quit early\n")

        while collected < target_raw:
            ret, frame = cap.read()
            if not ret:
                break

            frame   = cv2.flip(frame, 1)
            now     = time.time()
            rgb     = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
            results = self.hands.process(rgb)

            self._draw_hands(frame, results)

            has_hand = bool(results and results.multi_hand_landmarks)
            stab_buf.append(has_hand)
            stable = (len(stab_buf) == stab_buf.maxlen and all(stab_buf))

            h, w, _ = frame.shape
            progress = int((collected / target_raw) * (w - 30))

            # Header bar
            cv2.rectangle(frame, (0, 0), (w, 80), (20, 20, 30), -1)
            cv2.putText(frame, f"DIGIT: {digit}", (15, 42),
                        cv2.FONT_HERSHEY_SIMPLEX, 1.3, (0, 200, 255), 2)
            cv2.putText(frame,
                        f"Raw: {collected}/{target_raw}   "
                        f"JSON: {json_saved}   Images: {img_saved}",
                        (15, 68), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (180, 180, 180), 1)

            # Stability pill
            pill_col  = (0, 180, 60) if stable else (0, 60, 200)
            pill_text = "STABLE — capturing soon" if stable else "Hold still..."
            cv2.rectangle(frame, (10, h - 70), (360, h - 42), pill_col, -1)
            cv2.rectangle(frame, (10, h - 70), (360, h - 42), (255, 255, 255), 1)
            cv2.putText(frame, pill_text, (18, h - 50),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.65, (255, 255, 255), 2)

            # Progress bar
            cv2.rectangle(frame, (15, h - 30), (w - 15, h - 12), (40, 40, 40), -1)
            cv2.rectangle(frame, (15, h - 30), (15 + progress, h - 12), (0, 180, 200), -1)
            cv2.rectangle(frame, (15, h - 30), (w - 15, h - 12), (90, 90, 90), 1)
            cv2.putText(frame, f"{int(collected / target_raw * 100)}%",
                        (w // 2 - 15, h - 17),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.45, (255, 255, 255), 1)

            # Capture flash
            time_since = now - last_capture
            if 0 < time_since < 0.15:
                overlay = frame.copy()
                cv2.rectangle(overlay, (0, 0), (w, h), (0, 200, 255), -1)
                cv2.addWeighted(overlay, 0.18, frame, 0.82, 0, frame)

            cv2.imshow('Number Collector', frame)
            key = cv2.waitKey(1) & 0xFF
            if key == ord('q'):
                break

            # Auto-capture
            if stable and has_hand and (now - last_capture) >= INTERVAL:
                first_hand = results.multi_hand_landmarks[0]
                raw_lm = []
                for lm in first_hand.landmark:
                    raw_lm.extend([lm.x, lm.y, lm.z])

                ok, reason = self._check_quality(raw_lm)
                if not ok:
                    print(f"  Rejected: {reason}")
                    last_capture = now
                    continue

                ts         = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
                normalized = self._normalize_landmarks(raw_lm)
                lm_variants = self._augment_landmarks(normalized)

                # Save JSON variants
                for aug_idx, variant in enumerate(lm_variants):
                    data = {
                        "label":     digit,
                        "landmarks": variant,
                        "timestamp": ts,
                        "aug_type":  AUG_LM_TYPES[aug_idx],
                        "has_image": True,
                        "type":      "number",
                    }
                    fname = f"{digit}_{ts}_lm{aug_idx}.json"
                    with open(f"{save_dir}/{fname}", 'w') as f:
                        json.dump(data, f)
                    json_saved += 1

                # Save image variants
                hand_crop    = self._crop_hand_region(frame.copy(), results)
                img_variants = self._augment_image(hand_crop)

                for suffix, img_variant in img_variants:
                    img_fname = f"{digit}_{ts}_{suffix}.jpg"
                    cv2.imwrite(
                        f"{img_dir}/{img_fname}",
                        img_variant,
                        [cv2.IMWRITE_JPEG_QUALITY, 92],
                    )
                    img_saved += 1

                collected   += 1
                last_capture = now
                print(f"  [{collected}/{target_raw}]  "
                      f"+{len(lm_variants)} JSON  +{len(img_variants)} images  "
                      f"| Total: {json_saved} JSON, {img_saved} images")

        cap.release()
        cv2.destroyAllWindows()

        print(f"\n{'='*60}")
        print(f"DONE: digit {digit}")
        print(f"  Raw captured : {collected}")
        print(f"  JSON files   : {json_saved}")
        print(f"  Image files  : {img_saved}")
        print(f"  Saved to     : {save_dir}/")
        print(f"{'='*60}")
        return collected

    # ── Menus ─────────────────────────────────────────────────────────────────

    def _menu_single(self):
        while True:
            digit = input("\nDigit to collect (0-9) or 'done': ").strip()
            if digit.lower() in ('done', ''):
                break
            if digit not in self.VALID_DIGITS:
                print("Enter a single digit 0–9.")
                continue
            raw = input(f"Raw captures for '{digit}'? (default 20): ").strip()
            raw = int(raw) if raw.isdigit() else 20
            print("\nStarting in 3 seconds — show the sign...")
            time.sleep(3)
            self.collect_digit(digit, raw)

    def _menu_batch(self):
        digits_str = input(
            "\nDigits to collect (e.g. 0123456789 or 024): "
        ).strip()
        if not all(d in self.VALID_DIGITS for d in digits_str):
            print("Digits only (0-9)!")
            return
        digits_str = list(dict.fromkeys(digits_str))   # deduplicate, keep order
        raw = input("Raw captures per digit? (default 20): ").strip()
        raw = int(raw) if raw.isdigit() else 20
        for i, digit in enumerate(digits_str):
            print(f"\n[{i+1}/{len(digits_str)}] Starting '{digit}' in 3 seconds...")
            time.sleep(3)
            self.collect_digit(digit, raw)
        print(f"\nBatch complete! Collected {len(digits_str)} digits.")

    def run(self):
        while True:
            print("\n" + "="*80)
            print("ASL NUMBER COLLECTOR")
            print("="*80)
            print("\n1. Single digit  (collect one at a time)")
            print("2. Batch         (all digits in one session)")
            print("3. Full set      (0-9, 20 captures each — recommended)")
            print("4. Exit")

            choice = input("\nChoice: ").strip()

            if choice == '1':
                self._menu_single()

            elif choice == '2':
                self._menu_batch()

            elif choice == '3':
                raw = input("Raw captures per digit? (default 20): ").strip()
                raw = int(raw) if raw.isdigit() else 20
                print("\nCollecting all 10 digits (0-9).\n"
                      "Each digit starts after a 3-second countdown.\n")
                for i, digit in enumerate('0123456789'):
                    print(f"\n[{i+1}/10] Digit '{digit}' — starting in 3 seconds...")
                    time.sleep(3)
                    self.collect_digit(digit, raw)
                print("\nFull set complete!")
                print("Next step:  python number_trainer.py")

            elif choice == '4':
                print("\nGoodbye!")
                break
            else:
                print("Invalid choice.")

        print("\n" + "="*80)
        print("NEXT STEPS:")
        print("  Train: python number_trainer.py")
        print("  Run:   python asl_system.py   (numbers are loaded automatically)")
        print("="*80 + "\n")


def main():
    try:
        collector = NumberCollector()
        collector.run()
    except KeyboardInterrupt:
        print("\nInterrupted.")
    except Exception as e:
        print(f"\nError: {e}")
        import traceback
        traceback.print_exc()


if __name__ == "__main__":
    main()